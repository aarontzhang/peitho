{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -q '^git commit' && git push origin main 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Pushing to origin main..."
          }
        ]
      }
    ]
  }
}
